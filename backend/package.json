  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "redis": "^6.3.1",
    "ws": "^8.23.0",
    "bullmq": "^5.58.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
