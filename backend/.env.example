# Runtime environment (development | test | production)
NODE_ENV=development

# Database connection (use sslmode=verify-full for Neon / TLS connections)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=verify-full

# Dedicated test database connection (must differ from DATABASE_URL)
TEST_DATABASE_URL=postgresql://user:password@host/invenkai_test?sslmode=verify-full

# JWT authentication secret
JWT_SECRET=

# Backend server port
PORT=5001

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Redis connection
REDIS_URL=redis://localhost:6379

# Dedicated Redis database URL for BullMQ/integration tests
TEST_REDIS_URL=redis://localhost:6379/15
