# Runtime environment (development | test | production)
NODE_ENV=development

# Database connection (use sslmode=verify-full for Neon / TLS connections)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=verify-full

# Optional direct connection to the same database for marketplace LISTEN/NOTIFY.
# MARKET_LISTEN_DATABASE_URL=postgresql://user:password@direct-host/neondb?sslmode=verify-full

# Dedicated test database connection (must differ from DATABASE_URL)
TEST_DATABASE_URL=postgresql://user:password@host/invenkai_test?sslmode=verify-full

# JWT authentication secret
JWT_SECRET=

# Backend server port
PORT=5001

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Redis service on the Compose network. For a managed instance, use its rediss:// URL.
REDIS_URL=redis://redis:6379

# Separate test Redis instance (Pub/Sub channels span logical databases)
TEST_REDIS_URL=redis://localhost:6380

# Optional exact addresses of trusted reverse proxy hops, comma-separated
TRUSTED_PROXY_IPS=

# Google sign-in. Register CLIENT_URL + /home as the Google redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
